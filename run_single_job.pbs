#!/bin/bash
#PBS -N run_single_job
#PBS -o run_single_job.out
#PBS -e run_single_job.err
#PBS -l select=1:ncpus=1
#PBS -l walltime=24:00:00
#PBS -q nd
#PBS -V

# Go to submission directory
cd $PBS_O_WORKDIR

# Run MaSim
./bin/MaSim \
  -i ./conf/moz/test/validation_config.yaml \
  -o ./output/moz/validation/validation_ \
  -r SQLiteMonthlyReporter \
  -j 8888 \
  2>&1 | tee run_single_job.log
