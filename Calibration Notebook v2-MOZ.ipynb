    "---\n",
    "\n",
    "## Treatment Seeking Raster Adjustment\n",
    "\n",
    "The treatment seeking or treatment access rate raster is a percentage. It may be given as a value between 0 and 1 or between 0 and 100. The MaSim simulation expects this raster to be in the range of 0 to 1. If the raster is in the range of 0 to 100, we need to divide the raster by 100 to get it into the correct range."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "bc1e33c4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Treatment seeking rates: [0.451 0.486 0.561 0.603 0.661 0.676 0.755 0.783 0.787 0.847   nan]\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "from masim_analysis import utils\n",
    "from masim_analysis.configure import CountryParams\n",
    "import numpy as np\n",
    "\n",
    "raster, meta = utils.read_raster(Path(\"data\") / name / f\"{name}_treatmentseeking.asc\")\n",
    "if np.nanmax(raster) > 1.0:\n",
    "    print(\"Raster appears to be in the range 0-100. Dividing by 100 to convert to 0-1 range.\")\n",
    "    raster /= 100.0\n",
    "\n",
    "print(f\"Treatment seeking rates: {np.unique(raster)}\")\n",
    "\n",
    "utils.write_raster(raster, Path(\"data\") / name / f\"{name}_treatmentseeking.asc\", meta[\"xllcorner\"], meta[\"yllcorner\"])"
   ]
  },
